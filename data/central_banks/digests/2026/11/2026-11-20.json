          "id": "afdbc9847f0ccbb12af8cb27cd396058f429702b99d5b3c8e6b127225bdde2e0",
          "time": "2026-11-20T04:32:31+08:00",
          "central_bank": "FED",
          "headline": "Fed's Goolsbee: Consumer spending has been pretty broad-based, financed mostly out of income growth."
        },
